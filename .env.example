# Google Gemini API Key (Required for Gemini inference mode)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional model overrides
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=models/text-embedding-004

# Optional alternative backend (if using DeepSeek / Ollama)
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# OLLAMA_BASE_URL=http://localhost:11434

# Model API roots are approved server-side. A request base_url must match the
# selected engine's DEEPSEEK_BASE_URL, GEMINI_BASE_URL or CUSTOM_BASE_URL.
# CUSTOM_BASE_URL=http://localhost:11434/v1
# Optional exact production UI origins, comma-separated; no wildcard origins.
# A30_ALLOWED_ORIGINS=https://your-production-ui.example
